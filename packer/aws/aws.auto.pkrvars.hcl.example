# k8s_version/cilium_version/argocd_version are deliberately NOT set here —
# build.sh resolves them automatically before every build. A var-file entry
# of the same name would silently outrank that resolution; see README.md.

aws_region = "us-east-1"

# Required, no default — never 0.0.0.0/0. See README's "Prerequisites".
security_group_source_cidrs = ["203.0.113.0/24"]

# subnet_id/vpc_id left unset here — defaults to the account's default VPC.
# If your account has no default VPC, set both:
# subnet_id = "subnet-0123456789abcdef0"
# vpc_id    = "vpc-0123456789abcdef0"

# instance_type/ami_architecture left unset too, so a PKR_VAR_* override at
# build time (e.g. an arm64 build) isn't silently defeated — see README's
# "Building":
# instance_type    = "c8i.large"
# ami_architecture = "x86_64"

# extra_tags defaults to {} — see README's "Accounting tags":
# extra_tags = {
#   CostCenter = "platform"
#   Owner      = "your-name"
# }

# region_replicas defaults to [] — see README's "Multi-region replication":
# region_replicas = ["us-west-2", "eu-west-1"]
