{
  // Targets macOS, WSL2, and native Windows+Docker Desktop. initializeCommand
  // runs on the host before the container exists, so it uses the array form
  // (execs the named file directly, no shell) rather than a string (which
  // would run under cmd.exe on native Windows, breaking Unix-style flags) —
  // Unix resolves `initialize`, Windows resolves `initialize.cmd`. Same
  // technique as https://github.com/EliahKagan/portable-initialize.
  //
  // Native Windows without WSL2: the ~/.ssh mount needs real Unix permission
  // bits, which an NTFS bind mount doesn't have — write-env.sh's chmod pass
  // may not take effect there. If SSH-key-dependent operations fail with a
  // key-permission error, open this repo from within a WSL2 distro's own
  // filesystem instead (not /mnt/c/...). Unverified against a real
  // Windows/WSL2 machine.
  //
  // renovate: datasource=docker depName=ghcr.io/bbaliyan/kube-devenv
  "image": "ghcr.io/bbaliyan/kube-devenv:0.8.2",
  "name": "kube-image",

  "initializeCommand": [".devcontainer/initialize"],
  "postCreateCommand": "bash .devcontainer/write-env.sh && bash .devcontainer/post-create.sh",

  "mounts": [
    // ${localEnv:HOME}${localEnv:USERPROFILE}: only one resolves to a
    // non-empty string per host (HOME on macOS/Linux/WSL2, USERPROFILE on
    // native Windows), so concatenating both yields the one real path.
    //
    // Not readonly: write-env.sh chmods the keys after mount, which a
    // readonly bind mount would reject.
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/root/.ssh,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.kube-compute,target=/root/.kube-compute,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.aws,target=/root/.aws,type=bind"
  ],

  "remoteEnv": {
    "BASH_ENV": "/etc/kube-compute-env.sh",
    // Resolved via the ~/.aws mount above. Alternatively set
    // AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY in your shell profile.
    "AWS_PROFILE": "${localEnv:AWS_PROFILE}"
  },

  "remoteUser": "root",

  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "redhat.vscode-yaml",
        "foxundermoon.shell-format"
      ]
    }
  }
}
